# Apple Intelligence / Siri / Private Cloud Compute
# Policy: Apple Intelligence (PCC / Siri / AI) domains MUST proxy; everything else
# Apple stays direct via blackmatrix7 -> 🍎 Apple (= direct in this config).
# These host rules match BEFORE blackmatrix7, so its icloud.com/apple.com wildcards
# cannot leak PCC traffic to China CDNs.
host, gateway.icloud.com, PROXY
host-keyword, p152-, PROXY
host, p196-acsegateway.icloud.com, PROXY
host, gdmf.apple.com, PROXY
host, gdmf-ados.apple.com, PROXY
host, guzzoni.apple.com, PROXY
host-suffix, ls.apple.com, PROXY

host-suffix, smoot.apple.com, PROXY
host-suffix, apple-relay.apple.com, PROXY
host-suffix, apple-relay.cloudflare.com, PROXY
host-suffix, apple-relay.fastly-edge.com, PROXY
host-suffix, apple-relay.mask.apple-dns.net, PROXY
host-suffix, apple-relay.akamaized.net, PROXY
host-suffix, cp4.cloudflare.com, PROXY
host-suffix, cloud.com, PROXY
host-suffix, push.apple.com, PROXY

# PCC Mask / attestation (from RocM301 Apple-AI.list)
host, mask-api.fe.apple-dns.net, PROXY
host, mask-api.icloud.com, PROXY
host, mask-t.apple-dns.net, PROXY
host, mask.apple-dns.net, PROXY
host-suffix, mask-h2.icloud.com, PROXY
host-suffix, mask.icloud.com, PROXY
host-suffix, apps.mzstatic.com, PROXY

# OpenAI / ChatGPT (Apple Intelligence extension)
